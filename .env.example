# Copie para .env e ajuste. Nunca versione o .env.

# --- API ---
# Gere um segredo longo, por exemplo: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
POSTGRES_PASSWORD=cogni
FRONTEND_URL=http://localhost:8443
CORS_ORIGENS=http://localhost:8443

# E-mail por SMTP (opcional). Sem SMTP_HOST, o link de recuperação de senha aparece no log da API.
SMTP_HOST=
SMTP_PORTA=587
SMTP_USUARIO=
SMTP_SENHA=
SMTP_REMETENTE=Cogni <nao-responda@seu-dominio>

# --- Produção ---
DOMINIO=localhost

# --- Front-end (Vite) ---
# Em desenvolvimento a API roda em http://localhost:8000; em produção, atrás do Caddy, use /api
VITE_API_URL=http://localhost:8000
